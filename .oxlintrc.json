{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "env": { "browser": true },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": { "typescript/no-explicit-any": "off" }
    }
  ]
}
