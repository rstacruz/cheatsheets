{
  "name": "devhints-astro",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "node scripts/build-icons.mjs && astro build --silent",
    "ci": "npm run icons:check && concurrently -g \"npm:*:check\" \"vitest run\" \"npm:test:*\" \"npm:build\"",
    "dev": "node scripts/build-icons.mjs && astro dev",
    "fmt:check": "oxfmt --check .",
    "fmt:format": "oxfmt --write .",
    "format": "concurrently -m 1 \"npm:lint:format\" \"npm:fmt:format\"",
    "icons": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check",
    "lint:check": "oxlint --report-unused-disable-directives-severity=error .",
    "lint:format": "oxlint --fix .",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "vitest",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/ts-plugin": "^1.10.12",
    "@fontsource/cousine": "^5.0.15",
    "@fontsource/manrope": "^5.0.19",
    "@mapbox/rehype-prism": "^0.9.0",
    "@playwright/test": "^1.64.1",
    "@rstacruz/rehype-sectionize": "^0.7.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/mapbox__rehype-prism": "^0.8.3",
    "@types/mdast": "^4.0.4",
    "astro": "^7.4.5",
    "autocompleter": "^9.1.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "fuse.js": "^6.6.2",
    "gray-matter": "^4.0.3",
    "happy-dom": "^21.0.4",
    "hint.css": "^2.7.0",
    "playwright": "^1.64.1",
    "prismjs": "1.30.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "snarkdown": "^2.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "unified": "^11.0.3",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/ion": "^1.2.7",
    "@iconify/utils": "^3.1.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
