---
import { getSheetLogo } from '~/lib/logos'
import { resolveLogo, type LogoVariant } from '~/lib/logo-render'

export type Props = {
  slug: string
  size?: number
  variant?: LogoVariant
  class?: string
}

const {
  slug,
  size = 56,
  variant = 'bare',
  class: className
} = Astro.props as Props
const logo = resolveLogo(getSheetLogo(slug))
const tint = logo?.tint ? `;--logo-tint:${logo.tint}` : ''
---

{logo && (
  <span
    class:list={['logo-tile', `-${variant}`, className]}
    style={`--logo-size:${size}px${tint}`}
    aria-hidden="true"
  >
    {logo.kind === 'svg' ? (
      <svg {...logo.attributes} set:html={logo.body} />
    ) : (
      <img src={logo.src} alt="" />
    )}
  </span>
)}

<style is:global>
  @import '../styles/components/logo.css';
</style>
