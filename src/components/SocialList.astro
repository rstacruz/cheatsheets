---
import cx from 'clsx'
import { getUrlFromPage } from '~/lib/links'
import type { SheetPage } from '~/lib/page'
import Icon from './Icon.astro'

export type Props = {
  page?: SheetPage
}
const props = Astro.props as Props
const page = props.page
const url = getUrlFromPage(page, Astro.site)

const t = {
  facebookShare: 'Share on Facebook',
  xShare: 'Share on X',
  sheetDescription: 'The ultimate cheatsheet for {title}',
  defaultDescription: 'Ridiculous collection of web development cheatsheets'
}

const title = page?.frontmatter?.title

const description = title
  ? t.sheetDescription.replace('{title}', title)
  : t.defaultDescription

const tweet = `${description} ${url}`

// prettier-ignore
const facebookURL = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`
// prettier-ignore
const xURL = `https://x.com/intent/post?text=${encodeURIComponent(tweet)}`

const styles = {
  item: 'SocialList__item m-0 flex! list-none p-0',
  link: 'SocialList__link inline-flex h-[32px] w-[32px] items-center justify-center rounded-full text-muted-foreground no-underline transition-colors duration-100 hover:bg-accent hover:text-foreground focus:bg-accent focus:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring [&>svg]:block'
}
---

<li class={cx(styles.item, 'hint--bottom')} data-hint={t.facebookShare}>
  <a
    class={styles.link}
    href={facebookURL}
    target="share"
    aria-label={t.facebookShare}
    role="button"
  >
    <Icon name="logo-facebook" size={18} />
  </a>
</li>{' '}
<li class={cx(styles.item, 'hint--bottom')} data-hint={t.xShare}>
  <a
    class={styles.link}
    href={xURL}
    target="share"
    aria-label={t.xShare}
    role="button"
  >
    <Icon name="logo-x" size={18} />
  </a>
</li>
