---
import cx from 'clsx'
import type { SheetPage } from '~/lib/page'
import SocialList from './SocialList.astro'
import Icon from './Icon.astro'
import { getEditLink } from '~/lib/links'

export type Props = {
  noBack?: boolean
  noShare?: boolean
  noEdit?: boolean
  page?: SheetPage
}
const props = Astro.props as Props

const t = {
  title: 'Devhints.io',
  editOnGitHub: 'Edit on GitHub',
  edit: 'Edit',
  backToHome: 'Back to home'
}

const styles = {
  root: 'TopNav__root relative mb-[8px] h-[48px] border-b border-b-border-strong py-[8px] text-center leading-[64px] min-[481px]:mb-0 min-[481px]:h-[64px] min-[481px]:border-b-0 min-[481px]:py-0',
  inner:
    'TopNav__inner relative mx-auto flex h-[32px] max-w-content items-center px-[16px] leading-[32px] min-[481px]:mt-0 min-[481px]:h-[64px] min-[481px]:leading-[64px]',
  left: 'TopNav__left flex-none leading-[32px] min-[481px]:absolute min-[481px]:left-[16px] min-[481px]:top-[16px]',
  back: cx(
    'TopNav__back',
    'grid size-[32px] place-items-center rounded-full text-center text-muted-foreground no-underline transition-all duration-100 ease-linear',
    'hover:bg-primary hover:text-primary-foreground hover:opacity-100 focus:bg-primary focus:text-primary-foreground focus:opacity-100',
    'min-[481px]:size-[48px] min-[1232px]:relative min-[1232px]:-left-[16px]',
    '[&>svg]:inline-block [&>svg]:align-middle [&>svg]:text-foreground hover:[&>svg]:text-primary-foreground focus:[&>svg]:text-primary-foreground'
  ),
  brand:
    'TopNav__brand inline-block flex-auto text-xs font-bold leading-[32px] tracking-caps text-foreground uppercase no-underline hover:text-primary max-[481px]:hidden min-[481px]:leading-[64px]',
  actions:
    'TopNav__actions flex flex-none max-[481px]:ml-auto min-[481px]:absolute min-[481px]:right-[16px] min-[481px]:top-[16px]',
  socialList: 'TopNav__socialList m-0 h-[32px] list-none p-0',
  pageActions: 'TopNav__pageActions m-0 ml-[8px] flex h-[32px] list-none p-0',
  editItem: 'TopNav__editItem m-0 p-0 max-[769px]:ml-[16px]',
  editLink: cx(
    'TopNav__editLink',
    'inline-block align-top h-[32px] rounded-xs px-[16px] leading-[32px] text-foreground no-underline transition-all duration-100 ease-linear',
    '[box-shadow:inset_0_0_0_1px_var(--border-strong)]',
    'hover:bg-[image:var(--brand-gradient)] hover:text-primary-foreground hover:shadow-sm',
    'focus:bg-[image:var(--brand-gradient)] focus:text-primary-foreground focus:shadow-sm',
    '[&>svg]:relative [&>svg]:-top-[2px] [&>svg]:inline-block [&>svg]:align-middle'
  ),
  editText: 'relative -top-px ml-[4px] inline text-xs leading-[32px]'
}

const editLink = getEditLink(props.page)
---

<nav class={styles.root} data-js-no-preview role="navigation">
  <div class={styles.inner}>
    {props.noBack !== true ? (
      <div class={styles.left}>
        <a class={styles.back} href="/" aria-label={t.backToHome}>
          <Icon name="md-arrow-back" size={24} />
        </a>
      </div>
    ) : null}

    <a class={styles.brand} href="/">
      {t.title}
    </a>

    {props.noShare !== true ? (
      <div class={styles.actions}>
        {/* Social share links */}
        <ul class={styles.socialList}>
          <SocialList page={props.page} />
        </ul>

        {props.noEdit !== true ? (
          <ul class={styles.pageActions}>
            <li
              class={cx(styles.editItem, 'hint--bottom')}
              data-hint={t.editOnGitHub}
            >
              <a class={styles.editLink} href={editLink}>
                <Icon name="logo-github" size={16} />
                <span class={styles.editText}>{t.edit}</span>
              </a>
            </li>
          </ul>
        ) : null}
      </div>
    ) : null}
  </div>
</nav>
