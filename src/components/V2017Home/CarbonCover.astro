---
import { carbon } from '~/config'

const useCarbon = carbon.enabled

const styles = {
  root: 'HomePage__carbonCover col-span-full flex min-h-[280px] items-center justify-center overflow-hidden rounded-xl bg-secondary has-[#carbon-responsive]:min-h-0 min-[640px]:col-span-2',
  slot: 'HomePage__carbonCoverSlot flex w-full justify-center'
}
---

{useCarbon && (
  <div class={styles.root} role="complementary">
    <div class={styles.slot}>
      <script
        async
        type="text/javascript"
        src={carbon.coverSrc}
        id="_carbonads_js"
      />
    </div>
  </div>
)}
