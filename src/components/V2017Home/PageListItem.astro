---
import cx from 'clsx'
import Icon from '~/components/Icon.astro'
import Logo from '~/components/Logo.astro'
import type { SheetPage } from '../../lib/page'

const CARD_FRAGMENT_COUNT = 22

export type Props = {
  page: SheetPage
  variant?: 'list' | 'featured'
  showFragments?: boolean
}
const props = Astro.props as Props
const page = props.page
const url = `/${page.slug}`
const title = page.frontmatter.link_title ?? page.frontmatter.title ?? page.slug
const subtitle = page.frontmatter.subtitle
const sourceFragments = page.frontmatter.fragments ?? []
const fragments =
  props.showFragments && sourceFragments.length > 0
    ? Array.from(
        { length: CARD_FRAGMENT_COUNT },
        (_, index) => sourceFragments[index % sourceFragments.length]
      )
    : undefined

const featured = props.variant === 'featured'
const markSize = 28
const logo = page.frontmatter.logo
function getMarkTone() {
  if (!logo) {
    return featured
      ? '[color:color-mix(in_srgb,var(--primary-foreground)_80%,transparent)]'
      : 'text-primary'
  }
  if (featured) return 'text-primary-foreground'
  if (!('src' in logo)) return 'text-primary'
  return 'text-heading'
}
const markTone = getMarkTone()
const styles = {
  link: cx(
    'PageListItem__link',
    'group relative isolate flex min-w-0 flex-col gap-[8px] overflow-hidden rounded-xl no-underline',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',
    featured
      ? 'h-[280px] p-[24px] bg-steel-900 hover:bg-steel-800 focus-visible:bg-steel-800'
      : 'min-h-32 bg-secondary p-[16px] hover:bg-accent focus-visible:bg-accent'
  ),
  top: cx(
    'PageListItem__top relative z-10 flex min-h-0 flex-auto flex-col gap-[8px]'
  ),
  fragments: cx(
    'PageListItem__fragments mt-2 [transform:rotate(-30deg)_translate(4rem,-1rem)]',
    'motion-safe:transition-transform motion-safe:duration-200 motion-safe:ease-out',
    'motion-safe:group-hover:[transform:rotate(-30deg)_translate(4rem,-1rem)_scale(1.08)]',
    'flex min-h-0 flex-auto flex-wrap content-start gap-x-[5px] gap-y-[4px] overflow-hidden pr-[20%] opacity-50',
    '[&>:nth-child(3n)]:opacity-30',
    '[&>:nth-child(3n+1)]:opacity-60',
    '[&>:nth-child(3n+2)]:opacity-90',
    '[mask-image:linear-gradient(to_bottom,var(--mask-opaque)_50%,transparent)]',
    '[-webkit-mask-image:linear-gradient(to_bottom,var(--mask-opaque)_50%,transparent)]'
  ),
  fragment: cx(
    'PageListItem__fragment',
    'flex-none rounded-full bg-overlay-soft px-[7px] py-px font-handjet text-base leading-[18px] tracking-chip whitespace-nowrap',
    '[color:color-mix(in_srgb,var(--primary-foreground)_80%,transparent)]'
  ),
  mark: cx('PageListItem__mark flex items-center', markTone),
  markTint: cx(
    'PageListItem__markTint pointer-events-none absolute top-[40px] left-[130px] z-0 flex items-center',
    featured ? 'opacity-20' : 'opacity-10',
    '[transform:scale(8)] [filter:blur(256px)]',
    markTone
  ),
  title: cx(
    'PageListItem__title',
    'truncate shrink-0',
    featured
      ? 'font-manrope text-lg leading-[1.25] font-extrabold text-primary-foreground'
      : 'font-manrope font-semibold text-heading group-hover:text-primary group-focus-visible:text-primary'
  ),
  subtitle: cx(
    'PageListItem__subtitle',
    '-mt-2',
    'leading-[1.35] text-balance',
    featured
      ? 'text-primary-subtle'
      : 'truncate text-xs text-muted-foreground-subtle'
  ),
  text: cx('PageListItem__text relative z-10 flex shrink-0 flex-col gap-[8px]')
}
---

<a href={url} class={styles.link}>
  <span class={styles.markTint} aria-hidden="true">
    {logo ? (
      <Logo
        logo={logo}
        size={markSize}
        class={featured && logo.mono ? '[filter:invert(1)]' : undefined}
      />
    ) : (
      <Icon name="chevron-forward" size={markSize} />
    )}
  </span>
  <span class={styles.top}>
    <span class={styles.mark}>
      {logo ? (
        <Logo
          logo={logo}
          size={markSize}
          class={featured && logo.mono ? '[filter:invert(1)]' : undefined}
        />
      ) : (
        <Icon name="chevron-forward" size={markSize} />
      )}
    </span>
    {fragments && (
      <span class={styles.fragments} aria-hidden="true">
        {fragments.map((fragment, index) => (
          <span class={styles.fragment} style={`--fragment-index:${index}`}>
            {fragment}
          </span>
        ))}
      </span>
    )}
  </span>
  <span class={styles.text}>
    <span class={styles.title}>{title}</span>
    {subtitle && <span class={styles.subtitle}>{subtitle}</span>}
  </span>
</a>

<style is:global>
  @keyframes page-list-item-fragment-in {
    from {
      transform: translate3d(0, 12px, 0);
      filter: opacity(0);
    }

    to {
      transform: translate3d(0, 0, 0);
      filter: opacity(1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .PageListItem__fragment {
      animation: page-list-item-fragment-in 400ms ease-out both;
      animation-delay: calc(var(--fragment-index) * 80ms);
    }
  }
</style>
