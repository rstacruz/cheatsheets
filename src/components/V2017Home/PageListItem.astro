---
import type { SheetPage } from '../../lib/page'

export type Props = {
  page: SheetPage
  class?: string
  showFragments?: boolean
}
const props = Astro.props as Props
const page = props.page
const url = `/${page.slug}`
const title = page.frontmatter.title ?? page.slug
const subtitle = page.frontmatter.subtitle
const fragments = props.showFragments ? page.frontmatter.fragments : undefined
---

<a
  href={url}
  class={`article sheet-card item -item-${page.slug} ${props.class ?? ''}`}
>
  {fragments && fragments.length > 0 && (
    <span class="sheet-card__fragments" aria-hidden="true">
      {fragments.map((fragment) => (
        <span class="sheet-card__fragment">{fragment}</span>
      ))}
    </span>
  )}
  <span class="sheet-card__title">{title}</span>
  {subtitle && <span class="sheet-card__subtitle">{subtitle}</span>}
</a>
