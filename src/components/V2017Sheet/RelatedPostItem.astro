---
import cx from 'clsx'
import Icon from '~/components/Icon.astro'
import Logo from '~/components/Logo.astro'
import type { SheetPage } from '~/lib/page'

export type Props = {
  page: SheetPage
}
const props = Astro.props as Props
const page = props.page
const url = `/${page.slug}`
const title = page.frontmatter.link_title ?? page.frontmatter.title ?? page.slug
const subtitle = page.frontmatter.subtitle ?? 'cheatsheet'
const logo = page.frontmatter.logo

const styles = {
  root: 'RelatedPostItem__root m-[4px] flex flex-[1_1_auto] list-none p-0 text-left leading-[1.4] min-[481px]:flex-[1_1_40%]',
  link: cx(
    'RelatedPostItem__link',
    'group flex min-h-32 min-w-0 flex-[1_1_100%] flex-col gap-[2px] rounded-xl border border-border bg-card px-[14px] pt-[12px] pb-[14px] no-underline transition-colors duration-100',
    'hover:border-border-strong hover:bg-secondary',
    'focus-visible:border-border-strong focus-visible:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring'
  ),
  title:
    'RelatedPostItem__title font-manrope font-semibold wrap-break-word text-heading group-hover:text-primary group-focus-visible:text-primary',
  suffix:
    'RelatedPostItem__suffix truncate text-xs leading-[1.6] text-muted-foreground-subtle',
  mark: cx(
    'RelatedPostItem__mark mt-auto flex items-center pt-[10px]',
    logo ? 'text-heading' : 'text-primary-subtle'
  )
}
---

<li class={styles.root}>
  <a class={styles.link} href={url}>
    <span class={styles.title}>{title}</span>
    <span class={styles.suffix}>{subtitle}</span>
    <span class={styles.mark}>
      {logo ? (
        <Logo logo={logo} size={28} />
      ) : (
        <Icon name="chevron-forward" size={28} />
      )}
    </span>
  </a>
</li>
