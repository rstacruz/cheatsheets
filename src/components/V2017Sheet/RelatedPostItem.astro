---
import cx from 'clsx'
import type { SheetPage } from '~/lib/page'

export type Props = {
  featured?: boolean
  page: SheetPage
}
const props = Astro.props as Props
const page = props.page
const url = `/${page.slug}`
const title = page.frontmatter.link_title ?? page.frontmatter.title ?? page.slug

const t = {
  suffix: 'cheatsheet'
}

const featured = props.featured === true

const styles = {
  root: 'RelatedPostItem__root m-[4px] flex flex-[1_1_auto] list-none p-0 text-left leading-[1.4] min-[481px]:flex-[1_1_40%]',
  link: featured
    ? cx(
        'RelatedPostItem__link',
        'group block flex-[1_1_100%] rounded-xs p-[16px] no-underline [box-shadow:var(--shadow-sm)]',
        'bg-primary [color:color-mix(in_srgb,var(--card)_50%,transparent)]',
        'visited:[color:color-mix(in_srgb,var(--card)_50%,transparent)]',
        'hover:bg-primary-strong focus:bg-primary-strong',
        'hover:text-primary-foreground focus:text-primary-foreground'
      )
    : cx(
        'RelatedPostItem__link',
        'group block flex-[1_1_100%] rounded-xs p-[16px] no-underline [box-shadow:var(--shadow-sm)]',
        'bg-card text-muted-foreground visited:text-muted-foreground',
        'hover:text-primary focus:text-primary'
      ),
  title: cx(
    'RelatedPostItem__title',
    'text-base font-normal leading-[1.4] min-[481px]:block',
    featured
      ? 'text-primary-foreground'
      : 'text-primary group-hover:text-primary-active group-focus:text-primary-active'
  ),
  suffix: 'RelatedPostItem__suffix text-xs leading-[1.4] min-[481px]:block'
}
---

<li class={styles.root}>
  <a class={styles.link} href={url}>
    <strong class={styles.title}>{title}</strong>{' '}
    <span class={styles.suffix}>{t.suffix}</span>
  </a>
</li>
