---
import SearchForm from './SearchForm.astro'
import Icon from '~/components/Icon.astro'
---

<footer class="search-footer" data-js-no-preview>
  <div class="container">
    <div class="search-footer-section">
      <div class="search">
        <SearchForm class="-small" />
      </div>
      <div class="links">
        <a class="home-button" href="/">
          <i>
            <Icon name="ios-home-outline" size={24} />
          </i>
        </a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  @import '../../styles/components/home-button.css';
  @import '../../styles/components/search-footer.css';
</style>
