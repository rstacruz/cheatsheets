---
import cx from 'clsx'
import SearchForm from './SearchForm.astro'
import Icon from '~/components/Icon.astro'

export type Props = {
  count: number
}

const props = Astro.props as Props

const styles = {
  root: 'SearchFooter__root border-y border-y-border-strong bg-muted py-[16px]',
  inner: 'SearchFooter__inner mx-auto max-w-content px-[16px]',
  section: 'SearchFooter__section flex',
  search: 'SearchFooter__search [flex:0_1_640px]',
  links: 'SearchFooter__links ml-auto flex-initial pl-[16px]',
  home: cx(
    'SearchFooter__home',
    'inline-block rounded-circle text-muted-foreground visited:text-muted-foreground',
    '[box-shadow:inset_0_0_0_1px_var(--border-strong)]',
    'hover:bg-primary hover:text-primary-foreground focus:bg-primary focus:text-primary-foreground',
    '[&>i>svg]:inline-block [&>i>svg]:align-middle [&>i>svg]:size-[48px] [&>i>svg]:p-[12px]'
  )
}
---

<footer class={styles.root} data-js-no-preview>
  <div class={styles.inner}>
    <div class={styles.section}>
      <div class={styles.search}>
        <SearchForm size="small" count={props.count} />
      </div>
      <div class={styles.links}>
        <a class={styles.home} href="/">
          <i>
            <Icon name="ios-home-outline" size={24} />
          </i>
        </a>
      </div>
    </div>
  </div>
</footer>
