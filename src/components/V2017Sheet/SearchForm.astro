---
import 'autocompleter/autocomplete.css'

import Icon from '~/components/Icon.astro'

type BaseProps = {
  class?: string
}

export type Props =
  | (BaseProps & { isLive: true })
  | (BaseProps & { isLive?: false; count: number })
const t = {
  prefix: 'devhints.io',
  defaultPlaceholder: 'Search {size}+ cheatsheets',
  homePlaceholder: 'Search...'
}

const props = Astro.props as Props

const placeholder =
  props.isLive === true
    ? t.homePlaceholder
    : t.defaultPlaceholder.replace('{size}', props.count.toString())
---

<form class="search" action="/" method="get" data-js-search-form>
  <label class={`search-box ${props.class ?? ''}`}>
    <span class="prefix">{t.prefix}</span>
    <span class="sep">/</span>
    {
      <input
        name="q"
        type="text"
        class="input"
        {...(props.isLive ? { autofocus: true } : {})}
        data-js-search-input
        placeholder={placeholder}
        autocomplete="off"
      />
    }
    <span class="icon">
      <Icon name="md-search" size={32} />
    </span>
  </label>
</form>

<script>
  import { onScrollVisible } from '~/lib/domutils/onScrollVisible'

  // Prevent <enter> from submitting the form
  document
    .querySelectorAll<HTMLFormElement>('[data-js-search-form]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault()
      })
    })

  document
    .querySelectorAll<HTMLInputElement>('[data-js-search-input]')
    .forEach((input) => {
      onScrollVisible(input, async () => {
        const { setup } = await import('./SearchForm.script')
        setup(input)
      })
    })
</script>

<style is:global>
  @import '../../styles/components/search-box.css';
  @import '../../styles/vendor/autocomplete.css';
</style>
