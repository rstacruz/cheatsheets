---
import 'autocompleter/autocomplete.css'

import cx from 'clsx'
import Icon from '~/components/Icon.astro'

type BaseProps = {
  size?: 'default' | 'small'
  noAutocomplete?: boolean
}

export type Props =
  | (BaseProps & { isLive: true })
  | (BaseProps & { isLive?: false; count: number })
const t = {
  prefix: 'devhints.io',
  defaultPlaceholder: 'Search {size}+ cheatsheets',
  homePlaceholder: 'Search...'
}

const props = Astro.props as Props
const small = props.size === 'small'

const placeholder =
  props.isLive === true
    ? t.homePlaceholder
    : t.defaultPlaceholder.replace('{size}', props.count.toString())

const styles = {
  box: (small: boolean) =>
    cx(
      'SearchForm__box',
      'flex items-center rounded-full bg-field cursor-text',
      small ? 'h-[48px]' : 'h-[64px]',
      small ? '' : '[box-shadow:var(--shadow-neo)]',
      'focus-within:[box-shadow:var(--shadow-neo-focus)]'
    ),
  prefix: (small: boolean) =>
    cx(
      'SearchForm__prefix',
      'm-0 block border border-border px-[8px] py-[2px] font-normal leading-[1.5em] select-none rounded-full max-[769px]:hidden',
      '[color:color-mix(in_srgb,var(--muted-foreground)_50%,transparent)]',
      '[background-color:color-mix(in_srgb,var(--background)_50%,transparent)]',
      small ? 'ml-[11px] text-base' : 'ml-[19px] text-sm'
    ),
  sep: (small: boolean) =>
    cx(
      'SearchForm__sep',
      'mx-[8px] leading-[1.6] max-[769px]:hidden',
      '[color:color-mix(in_srgb,var(--muted-foreground)_50%,transparent)]',
      small ? 'text-base' : 'text-lg'
    ),
  input: (small: boolean) =>
    cx(
      'SearchForm__input',
      'min-w-[48px] flex-auto cursor-text border-0 bg-transparent pl-0 font-body font-bold leading-[1.6] text-heading focus:outline-none',
      'placeholder:font-normal placeholder:text-muted-foreground',
      'max-[769px]:pl-[16px]',
      small
        ? 'h-[48px] py-[8px] pr-[8px] text-base'
        : 'h-[64px] py-[16px] pr-[16px] text-lg'
    ),
  submit: (small: boolean) =>
    cx(
      'SearchForm__submit',
      'order-2 mr-3 flex flex-none items-center justify-center rounded-full bg-transparent',
      'text-sm font-semibold no-underline text-heading',
      'data-[active=true]:bg-[image:var(--brand-gradient)]',
      'data-[active=true]:text-primary-foreground',
      'data-[active=true]:hover:bg-none data-[active=true]:hover:bg-primary-active',
      'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',
      'px-[12px] data-[active=true]:px-[16px]',
      small ? 'h-[40px] [&>svg]:size-[20px]' : 'h-[48px] [&>svg]:size-[24px]'
    )
}
---

<form action="/" method="get" data-js-search-form>
  <label class={styles.box(small)}>
    <span class={styles.prefix(small)}>{t.prefix}</span>
    <span class={styles.sep(small)}>/</span>
    <input
      name="q"
      type="text"
      class={styles.input(small)}
      data-js-search-input
      placeholder={placeholder}
      autocomplete="off"
      data-js-no-autocomplete={props.noAutocomplete ? '' : undefined}
    />
    <button
      type="button"
      class={styles.submit(small)}
      data-js-search-submit
      aria-label="Search"
      aria-disabled="true"
      data-active="false"
    >
      <Icon name="md-search" size={small ? 20 : 24} />
    </button>
  </label>
</form>

<script>
  import { onScrollVisible } from '~/lib/domutils/onScrollVisible'

  document
    .querySelectorAll<HTMLFormElement>('[data-js-search-form]')
    .forEach((form) => {
      const input = form.querySelector<HTMLInputElement>(
        '[data-js-search-input]'
      )
      const button = form.querySelector<HTMLButtonElement>(
        '[data-js-search-submit]'
      )
      const sync = () => {
        const active = Boolean(input?.value.trim())
        if (button) {
          button.dataset.active = String(active)
          button.setAttribute('aria-disabled', String(!active))
        }
      }
      sync()
      input?.addEventListener('input', sync)
      button?.addEventListener('click', (event) => {
        event.preventDefault()
        const query = input?.value.trim() ?? ''
        if (!query) return
        if (input?.hasAttribute('data-js-no-autocomplete')) {
          form.requestSubmit()
        } else {
          location.assign(`/search?q=${encodeURIComponent(query)}`)
        }
      })

      form.addEventListener('submit', (event) => {
        event.preventDefault()
      })
    })

  document
    .querySelectorAll<HTMLInputElement>('[data-js-search-input]')
    .forEach((input) => {
      if (input.hasAttribute('data-js-no-autocomplete')) return
      onScrollVisible(input, async () => {
        const { setup } = await import('./SearchForm.script')
        setup(input)
      })
    })
</script>

<style is:global>
  @import '../../styles/vendor/autocomplete.css';
</style>
