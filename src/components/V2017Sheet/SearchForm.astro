---
import 'autocompleter/autocomplete.css'

import cx from 'clsx'
import Icon from '~/components/Icon.astro'

type BaseProps = {
  size?: 'default' | 'small'
}

export type Props =
  | (BaseProps & { isLive: true })
  | (BaseProps & { isLive?: false; count: number })
const t = {
  prefix: 'devhints.io',
  defaultPlaceholder: 'Search {size}+ cheatsheets',
  homePlaceholder: 'Search...'
}

const props = Astro.props as Props
const small = props.size === 'small'

const placeholder =
  props.isLive === true
    ? t.homePlaceholder
    : t.defaultPlaceholder.replace('{size}', props.count.toString())

const styles = {
  box: (small: boolean) =>
    cx(
      'flex items-center rounded-full bg-card cursor-text',
      '[box-shadow:var(--shadow-md)]',
      'focus-within:[box-shadow:var(--shadow-focus)]',
      small ? 'h-[48px]' : 'h-[64px]'
    ),
  prefix: (small: boolean) =>
    cx(
      'm-0 block border border-border px-[8px] py-[2px] font-normal leading-[1.5em] select-none rounded-full max-[769px]:hidden',
      '[color:color-mix(in_srgb,var(--muted-foreground)_50%,transparent)]',
      '[background-color:color-mix(in_srgb,var(--background)_50%,transparent)]',
      small ? 'ml-[11px] text-base' : 'ml-[19px] text-sm'
    ),
  sep: (small: boolean) =>
    cx(
      'mx-[8px] leading-[1.6] max-[769px]:hidden',
      '[color:color-mix(in_srgb,var(--muted-foreground)_50%,transparent)]',
      small ? 'text-base' : 'text-lg'
    ),
  input: (small: boolean) =>
    cx(
      'min-w-[48px] flex-auto cursor-text border-0 bg-transparent pl-0 font-body font-bold leading-[1.6] text-heading focus:outline-none',
      'placeholder:font-normal placeholder:text-muted-foreground',
      'max-[769px]:pl-[16px]',
      small
        ? 'h-[48px] py-[8px] pr-[8px] text-base'
        : 'h-[64px] py-[16px] pr-[16px] text-lg'
    ),
  icon: (small: boolean) =>
    cx(
      'order-2 grid place-items-center text-heading',
      small
        ? 'w-[48px] flex-[0_0_48px] [&>svg]:size-[24px]'
        : 'w-[64px] flex-[0_0_64px] [&>svg]:size-[32px]'
    )
}
---

<form action="/" method="get" data-js-search-form>
  <label class={styles.box(small)}>
    <span class={styles.prefix(small)}>{t.prefix}</span>
    <span class={styles.sep(small)}>/</span>
    <input
      name="q"
      type="text"
      class={styles.input(small)}
      {...(props.isLive ? { autofocus: true } : {})}
      data-js-search-input
      placeholder={placeholder}
      autocomplete="off"
    />
    <span class={styles.icon(small)}>
      <Icon name="md-search" size={small ? 24 : 32} />
    </span>
  </label>
</form>

<script>
  import { onScrollVisible } from '~/lib/domutils/onScrollVisible'

  // Prevent <enter> from submitting the form
  document
    .querySelectorAll<HTMLFormElement>('[data-js-search-form]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault()
      })
    })

  document
    .querySelectorAll<HTMLInputElement>('[data-js-search-input]')
    .forEach((input) => {
      onScrollVisible(input, async () => {
        const { setup } = await import('./SearchForm.script')
        setup(input)
      })
    })
</script>

<style is:global>
  @import '../../styles/vendor/autocomplete.css';
</style>
