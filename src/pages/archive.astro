---
import { site } from '~/config'
import { getPages } from '~/lib/page'
import { getArchivedPages } from '~/lib/page/queries'
import { typeStyles } from '~/styles/CommonStyles'
import BaseLayout from '~/components/BaseLayout.astro'
import TopNav from '~/components/TopNav.astro'
import PageListItem from '~/components/V2017Home/PageListItem.astro'
import SEO from '~/components/SEO/SEO.astro'

const pages = await getPages()
const archivedPages = getArchivedPages(pages)

const t = {
  title: 'Archive',
  description:
    'Cheatsheets hidden from the homepage. Kept reachable, just less prominent.'
}

const styles = {
  body: 'V2017Sheet__body max-w-slim p-6 md:px-8 mx-auto'
}

const headingStyles = {
  root: 'SiteHeading__root my-12 text-center',
  h1: `SiteHeading__h1 ${typeStyles.manrope} text-5xl text-zinc-950`,
  tagline: 'SiteHeading__tagline text-xl mt-4'
}
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title="Archive — Devhints.io cheatsheets"
      links={{ canonical: `${site.url}/archive` }}
      meta={{ description: t.description }}
    />
  </Fragment>
  <TopNav noEdit noBack noShare />
  <div class={styles.body}>
    <div class={headingStyles.root}>
      <h1 class={headingStyles.h1}>{t.title}</h1>
      <p class={headingStyles.tagline}>{t.description}</p>
    </div>
    <div class="pages-list" role="main">
      {archivedPages.map((page) => <PageListItem page={page} />)}
      {
        archivedPages.length === 0 ? (
          <p class="item text-center text-zinc-500">No archived cheatsheets.</p>
        ) : null
      }
    </div>
  </div>
</BaseLayout>

<style lang="scss" is:global>
  @import '../sass/2017/utils';
  @import '../sass/2017/components/pages-list';
</style>
