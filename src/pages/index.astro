---
import cx from 'clsx'
import { getPages } from '~/lib/page'
import { getSEOPropsForHome } from '~/lib/seo/seo'
import {
  getPagesByCategory,
  getFeaturedPages,
  getRecentPages,
  getSnippetPages
} from '~/lib/page/queries'
import { selectWeeklySnippets } from '~/lib/weeklySnippets'
import TopNav from '~/components/TopNav.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import PageListItem from '~/components/V2017Home/PageListItem.astro'
import SnippetLink from '~/components/V2017Home/SnippetLink.astro'
import FeaturedPages from '~/components/V2017Home/FeaturedPages.astro'
import Announcements from '~/components/V2017Home/Announcements.astro'
import SearchForm from '~/components/V2017Sheet/SearchForm.astro'
import SEO from '~/components/SEO/SEO.astro'
import { typeStyles } from '~/styles/CommonStyles'
import { urls } from '~/config'

const pages = await getPages()
const pageCategories = getPagesByCategory(pages, { excludeSnippets: true })
const featuredPages = getFeaturedPages(pages, {
  maxCount: 10,
  excludeSnippets: true
})
const recentPages = getRecentPages(pages, {
  maxCount: 12,
  excludeSnippets: true
})
const snippetPages = selectWeeklySnippets(getSnippetPages(pages), new Date())

const seoProps = getSEOPropsForHome()
const t = {
  title: "Rico's cheatsheets",
  tagline: `Hey! I'm <a href='https://ricostacruz.com'>@rstacruz</a> and this is a modest collection of cheatsheets I've written.`,
  recentlyUpdated: 'Recently updated',
  snippets: 'Snippets',
  allSnippets: 'See all snippets',
  seeSomethingMissing: 'See something missing?',
  requestCheatsheet: 'Request cheatsheet'
}

const styles = {
  body: 'V2017Sheet__body max-w-home p-6 md:px-8 mx-auto',
  pagesList:
    'HomePage__pagesList pages-list grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-[16px]',
  category: cx(
    'HomePage__category col-span-full',
    'mt-0 mb-4 border-t border-t-border pt-4',
    'text-xl text-heading',
    typeStyles.manrope
  ),
  snippetList: cx(
    'HomePage__snippetList',
    'col-span-full grid grid-cols-[minmax(0,1fr)] gap-x-[24px] border-t border-t-border',
    'min-[769px]:grid-cols-[repeat(2,minmax(0,1fr))]'
  ),
  snippetMore: cx(
    'HomePage__snippetMore',
    'col-span-full text-center text-sm text-muted-foreground'
  ),
  missingMessage: cx(
    'HomePage__missingMessage',
    'col-span-full',
    'my-[32px] flex items-center border-t border-t-border-strong pt-[16px] text-center',
    'min-[769px]:pt-[32px] max-[481px]:flex-wrap'
  ),
  missingTitle: cx(
    'HomePage__missingTitle',
    'm-0 flex-[1_0_auto] p-0 text-left text-base font-normal text-foreground',
    "before:mr-[16px] before:inline-block before:size-[24px] before:content-[''] before:bg-current before:align-middle before:text-primary",
    'before:[mask:var(--icon-md-arrow-forward)_center/24px_24px_no-repeat]',
    'before:[-webkit-mask:var(--icon-md-arrow-forward)_center/24px_24px_no-repeat]'
  ),
  missingBody:
    'HomePage__missingBody m-0 flex-[0_0_auto] p-0 text-muted-foreground max-[481px]:mt-[16px]',
  pushButton: cx(
    'HomePage__pushButton',
    'inline-block rounded-xs px-[16px] py-[8px] no-underline',
    'text-primary-foreground visited:text-primary-foreground',
    'bg-[image:var(--brand-gradient)]',
    'hover:bg-none hover:bg-primary-active focus:bg-none focus:bg-primary-active',
    'hover:[box-shadow:none] focus:[box-shadow:none]'
  )
}

const headingStyles = {
  root: cx('SiteHeading__root', 'my-12 text-center'),
  h1: cx('SiteHeading__h1', typeStyles.manrope, 'text-5xl text-heading'),
  tagline: cx('SiteHeading__tagline', 'text-xl', 'mt-4')
}
---

<BaseLayout>
  <Fragment slot="head">
    <SEO {...seoProps} />
  </Fragment>
  <TopNav noEdit noBack />
  <div class={styles.body}>
    <div class={headingStyles.root}>
      <h1 class={headingStyles.h1}>{t.title}</h1>
      <p class={headingStyles.tagline} set:html={t.tagline} />
    </div>
    <div role="banner">
      <SearchForm isLive />

      <div class="mt-8"></div>
    </div>

    <div class={styles.pagesList} role="main">
      {/* Featured pages */}
      <FeaturedPages pages={featuredPages} />

      {/* Recent pages */}
      <h2 class={styles.category} data-js-searchable-header>
        <span>{t.recentlyUpdated}</span>
      </h2>
      {recentPages.map((page) => (
        <PageListItem page={page} />
      ))}

      {Object.values(pageCategories).map((category) => {
        if (category.pages.length === 0) return

        return (
          <>
            <h2 class={styles.category} data-js-searchable-header>
              <span>{category.title}</span>
            </h2>

            {category.pages.map((page) => (
              <PageListItem page={page} />
            ))}
          </>
        )
      })}

      {snippetPages.length > 0 && (
        <>
          <h2 class={styles.category} data-js-searchable-header>
            <span>{t.snippets}</span>
          </h2>
          <div class={styles.snippetList}>
            {snippetPages.map((page) => (
              <SnippetLink page={page} />
            ))}
          </div>
          <p class={styles.snippetMore}>
            <a class="text-primary hover:underline" href="/snippets">
              {t.allSnippets}
            </a>
          </p>
        </>
      )}

      <div class={styles.missingMessage}>
        <h3 class={styles.missingTitle}>{t.seeSomethingMissing}</h3>
        <p class={styles.missingBody}>
          <a class={styles.pushButton} href={urls.newCheatsheetUrl}>
            {t.requestCheatsheet}
          </a>
        </p>
      </div>

      <p class="col-span-full pt-8 text-center text-sm text-muted-foreground">
        <a class="hover:underline" href="/archive">
          Archive
        </a>{' '}
        — older cheatsheets
      </p>
    </div>
  </div>
  <Announcements />
</BaseLayout>
