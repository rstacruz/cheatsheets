---
import { getPages } from '~/lib/page'
import { getSEOPropsForHome } from '~/lib/seo/seo'
import {
  getPagesByCategory,
  getFeaturedPages,
  getRecentPages,
  getSnippetPages
} from '~/lib/page/queries'
import { selectWeeklySnippets } from '~/lib/weeklySnippets'
import TopNav from '~/components/TopNav.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import PageListItem from '~/components/V2017Home/PageListItem.astro'
import SnippetLink from '~/components/V2017Home/SnippetLink.astro'
import FeaturedPages from '~/components/V2017Home/FeaturedPages.astro'
import Announcements from '~/components/V2017Home/Announcements.astro'
import SearchForm from '~/components/V2017Sheet/SearchForm.astro'
import SEO from '~/components/SEO/SEO.astro'
import { headingStyles, homeStyles } from '~/styles/CommonStyles'
import { urls } from '~/config'

const pages = await getPages()
const pageCategories = getPagesByCategory(pages, { excludeSnippets: true })
const featuredPages = getFeaturedPages(pages, {
  maxCount: 10,
  excludeSnippets: true
})
const recentPages = getRecentPages(pages, {
  maxCount: 12,
  excludeSnippets: true
})
const snippetPages = selectWeeklySnippets(getSnippetPages(pages), new Date())

const seoProps = getSEOPropsForHome()
const t = {
  title: "Rico's cheatsheets",
  tagline: `Hey! I'm <a href='https://ricostacruz.com'>@rstacruz</a> and this is a modest collection of cheatsheets I've written.`,
  recentlyUpdated: 'Recently updated',
  snippets: 'Snippets',
  allSnippets: 'See all snippets',
  seeSomethingMissing: 'See something missing?',
  requestCheatsheet: 'Request cheatsheet'
}

---

<BaseLayout>
  <Fragment slot="head">
    <SEO {...seoProps} />
    <script is:inline>
      var q = new URLSearchParams(location.search).get('q')?.trim()
      if (q) location.replace('/search?q=' + encodeURIComponent(q))
    </script>
  </Fragment>
  <TopNav noEdit />
  <div class={homeStyles.body}>
    <div class={headingStyles.root}>
      <h1 class={headingStyles.h1}>{t.title}</h1>
      <p class={headingStyles.tagline} set:html={t.tagline} />
    </div>
    <div role="banner">
      <SearchForm isLive />

      <div class="mt-8"></div>
    </div>

    <div class={homeStyles.pagesList} role="main">
      {/* Featured pages */}
      <FeaturedPages pages={featuredPages} />

      {/* Recent pages */}
      <h2 class={homeStyles.category} data-js-searchable-header>
        <span>{t.recentlyUpdated}</span>
      </h2>
      {recentPages.map((page) => (
        <PageListItem page={page} />
      ))}

      {Object.values(pageCategories).map((category) => {
        if (category.pages.length === 0) return

        return (
          <>
            <h2 class={homeStyles.category} data-js-searchable-header>
              <span>{category.title}</span>
            </h2>

            {category.pages.map((page) => (
              <PageListItem page={page} />
            ))}
          </>
        )
      })}

      {snippetPages.length > 0 && (
        <>
          <h2 class={homeStyles.category} data-js-searchable-header>
            <span>{t.snippets}</span>
          </h2>
          <div class={homeStyles.snippetList}>
            {snippetPages.map((page) => (
              <SnippetLink page={page} />
            ))}
          </div>
          <p class={homeStyles.snippetMore}>
            <a class="text-primary hover:underline" href="/snippets">
              {t.allSnippets}
            </a>
          </p>
        </>
      )}

      <div class={homeStyles.missingMessage}>
        <h3 class={homeStyles.missingTitle}>{t.seeSomethingMissing}</h3>
        <p class={homeStyles.missingBody}>
          <a class={homeStyles.pushButton} href={urls.newCheatsheetUrl}>
            {t.requestCheatsheet}
          </a>
        </p>
      </div>

      <p class="col-span-full pt-8 text-center text-sm text-muted-foreground">
        <a class="hover:underline" href="/archive">
          Archive
        </a>{' '}
        — older cheatsheets
      </p>
    </div>
  </div>
  <Announcements />
</BaseLayout>
