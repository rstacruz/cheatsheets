---
import cx from 'clsx'
import { site } from '~/config'
import { formatShortDate } from '~/lib/dates'
import { getPages } from '~/lib/page'
import { getNewPages, getUpdatedPages } from '~/lib/page/queries'
import { typeStyles } from '~/styles/CommonStyles'
import BaseLayout from '~/components/BaseLayout.astro'
import TopNav from '~/components/TopNav.astro'
import PageListItem from '~/components/V2017Home/PageListItem.astro'
import FeaturedPages from '~/components/V2017Home/FeaturedPages.astro'
import SEO from '~/components/SEO/SEO.astro'

const pages = await getPages()
const newPages = getNewPages(pages)
const updatedPages = getUpdatedPages(pages)

const t = {
  title: 'Latest',
  description: 'Newest and recently updated cheatsheets.',
  new: 'New cheatsheets',
  updated: 'Recently updated'
}

const styles = {
  body: 'V2017Sheet__body max-w-home p-6 md:px-8 mx-auto',
  sectionTitle: cx(
    'LatestPage__section',
    'mt-[32px] mb-[16px] border-b border-b-border-strong pb-[16px] text-base font-normal text-primary'
  ),
  pagesList:
    'LatestPage__pagesList pages-list grid grid-cols-2 gap-[16px] min-[481px]:grid-cols-[repeat(auto-fill,minmax(220px,1fr))]'
}

const headingStyles = {
  root: 'SiteHeading__root my-12 text-center',
  h1: `SiteHeading__h1 ${typeStyles.manrope} text-5xl text-heading`,
  tagline: 'SiteHeading__tagline text-xl mt-4'
}
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title="Latest — Devhints.io cheatsheets"
      links={{ canonical: `${site.url}/latest` }}
      meta={{ description: t.description }}
    />
  </Fragment>
  <TopNav noEdit noShare />
  <div class={styles.body}>
    <div class={headingStyles.root}>
      <h1 class={headingStyles.h1}>{t.title}</h1>
      <p class={headingStyles.tagline}>{t.description}</p>
    </div>
    <div role="main">
      <FeaturedPages pages={newPages.slice(0, 2)} />
      <section id="new-pages">
        <h2 class={styles.sectionTitle}>{t.new}</h2>
        <div class={styles.pagesList}>
          {newPages.map((page) => (
            <PageListItem
              page={page}
              meta={`Added ${formatShortDate(page.frontmatter.created_at)}`}
            />
          ))}
        </div>
      </section>
      <section id="updated-pages">
        <h2 class={styles.sectionTitle}>{t.updated}</h2>
        <div class={styles.pagesList}>
          {updatedPages.map((page) => (
            <PageListItem
              page={page}
              meta={`Updated ${formatShortDate(page.frontmatter.updated!)}`}
            />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
