---
import BaseLayout from '~/components/BaseLayout.astro'
import TopNav from '~/components/TopNav.astro'
import SEO from '~/components/SEO/SEO.astro'
import { site } from '~/config'
import { getPages } from '~/lib/page'
import { typeStyles } from '~/styles/CommonStyles'

const pages = await getPages()
const sampleSlugs = [
  'vue',
  'bash',
  'docker',
  'git',
  'minimist',
  'css-grid',
  'heroku',
  'vim',
  'typescript',
  'rails',
  'tmux',
  'graphql'
]
const samples = sampleSlugs
  .map((slug) => pages[slug])
  .filter((page) => page !== undefined)

const variants = [
  {
    id: 'inline',
    title: '1. Inline rows',
    note: 'Two columns, title and subtitle on one line. Closest to the old list, but the subtitle always shows.'
  },
  {
    id: 'cards',
    title: '2. Bordered cards',
    note: 'The shipping default. Three columns at the homepage width, one on mobile.'
  },
  {
    id: 'compact',
    title: '3. Compact grid',
    note: 'No borders. Easier to scan, less visually busy with 350+ entries.'
  },
  {
    id: 'eyebrow',
    title: '4. Category eyebrow',
    note: 'Adds the category above the title. Slower to scan, but tells you where a sheet lives.'
  }
]

const styles = {
  body: 'V2017Sheet__body max-w-content p-6 md:px-8 mx-auto'
}
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title="Homepage card specimens — Devhints.io cheatsheets"
      links={{ canonical: `${site.url}/specimens/home-cards` }}
      meta={{ description: 'Layout variants for the homepage sheet cards.' }}
    />
  </Fragment>
  <TopNav noEdit noBack noShare />

  <div class={styles.body}>
    <header class="specimen-heading">
      <h1 class={typeStyles.manrope}>Homepage card specimens</h1>
      <p>
        Four ways to show a sheet's title and five-word subtitle in the homepage
        listing. All cards use real sheet data.
      </p>
    </header>

    {variants.map((variant) => (
      <section class="specimen-section">
        <h2 class={typeStyles.manrope}>{variant.title}</h2>
        <p class="note">{variant.note}</p>

        <div class={`specimen-grid specimen-grid--${variant.id}`}>
          {samples.map((page) => (
            <a href={`/${page.slug}`} class="card" data-variant={variant.id}>
              {variant.id === 'eyebrow' && (
                <span class="card__eyebrow">{page.frontmatter.category}</span>
              )}
              <span class="card__title">
                {page.frontmatter.title ?? page.slug}
              </span>
              <span class="card__subtitle">{page.frontmatter.subtitle}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="specimen-section">
      <h2 class={typeStyles.manrope}>5. Featured tile</h2>
      <p class="note">
        The featured row on the homepage. Colored tiles keep the title and put
        the subtitle underneath.
      </p>

      <div class="specimen-grid specimen-grid--featured">
        {samples.slice(0, 6).map((page, index) => (
          <a
            href={`/${page.slug}`}
            class="card card--featured"
            data-tone={index % 3}
          >
            <span class="card__title">
              {page.frontmatter.title ?? page.slug}
            </span>
            <span class="card__subtitle">{page.frontmatter.subtitle}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="footer-note">
      Variant 2 ships in <code>PageListItem.astro</code>.
    </p>
  </div>
</BaseLayout>

<style>
  .specimen-heading {
    margin: 48px 0;
    max-width: 640px;
  }

  .specimen-heading h1 {
    font-size: 40px;
    color: var(--base-head);
  }

  .specimen-heading p {
    margin-top: 12px;
    font-size: 18px;
    color: var(--base-mute);
  }

  .specimen-section {
    margin: 48px 0;
  }

  .specimen-section h2 {
    font-size: 24px;
    color: var(--base-head);
  }

  .note {
    margin: 4px 0 16px;
    color: var(--base-mute3);
    font-size: 14px;
  }

  .specimen-grid {
    display: grid;
    gap: 8px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid var(--dark-line-color);
    border-radius: 4px;
    text-decoration: none;
  }

  .card__title {
    color: var(--base-head);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card__subtitle {
    color: var(--base-mute3);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card:hover {
    border-color: var(--base-a3);
    background: var(--base-panel);
  }

  .card:hover .card__title {
    color: var(--base-a);
  }

  /* 1. Inline rows */
  .specimen-grid--inline {
    grid-template-columns: 1fr 1fr;
  }

  .card[data-variant='inline'] {
    display: block;
    border: 0;
    padding: 2px 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .card[data-variant='inline'] .card__title::after {
    content: ' — ';
    color: var(--base-mute3);
    font-weight: normal;
  }

  /* 2. Bordered cards */
  .specimen-grid--cards {
    grid-template-columns: repeat(3, 1fr);
  }

  /* 3. Compact grid */
  .specimen-grid--compact {
    grid-template-columns: repeat(4, 1fr);
    gap: 0 24px;
  }

  .card[data-variant='compact'] {
    border: 0;
    padding: 4px 0;
  }

  .card[data-variant='compact'] .card__title {
    font-weight: 500;
  }

  /* 4. Category eyebrow */
  .specimen-grid--eyebrow {
    grid-template-columns: 1fr 1fr;
  }

  .card__eyebrow {
    color: var(--base-mute3);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* 5. Featured tiles */
  .specimen-grid--featured {
    grid-template-columns: repeat(3, 1fr);
  }

  .card--featured {
    border: 0;
    padding: 12px 14px;
    border-radius: 3px;
    box-shadow: var(--shadow2);
    text-shadow: 0 1px 1px rgb(51 68 85 / 30%);
  }

  .card--featured .card__title,
  .card--featured .card__subtitle {
    color: white;
  }

  .card--featured .card__subtitle {
    color: rgb(255 255 255 / 78%);
  }

  .card--featured[data-tone='0'] {
    background: linear-gradient(15deg, var(--base-a), var(--base-a-bright));
  }

  .card--featured[data-tone='1'] {
    background: linear-gradient(
      15deg,
      var(--base-mute),
      var(--base-mute-bright)
    );
  }

  .card--featured[data-tone='2'] {
    background: linear-gradient(15deg, var(--base-c), var(--base-c-bright));
  }

  .footer-note {
    margin: 48px 0;
    color: var(--base-mute3);
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .specimen-grid--inline,
    .specimen-grid--cards,
    .specimen-grid--compact,
    .specimen-grid--eyebrow,
    .specimen-grid--featured {
      grid-template-columns: 1fr;
    }

    .card[data-variant='inline'] {
      white-space: normal;
    }
  }
</style>
