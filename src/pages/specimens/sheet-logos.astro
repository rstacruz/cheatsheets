---
import BaseLayout from '~/components/BaseLayout.astro'
import Logo from '~/components/Logo.astro'
import SheetLogoSpecimen, {
  type Placement
} from '~/components/Specimens/SheetLogoSpecimen.astro'
import { getPages } from '~/lib/page'

const pages = await getPages()
const react = pages.react
const go = pages.go
const herdr = pages.herdr
const xpath = pages.xpath
const curl = pages.curl
const claude = pages['claude-code']
const skills = pages.skills
const mise = pages.mise

const marks = [
  ['react', 'colour'],
  ['claude-code', 'colour'],
  ['go', 'mono square'],
  ['skills', 'glyph'],
  ['xpath', 'glyph'],
  ['curl', 'mono square'],
  ['herdr', 'image'],
  ['mise', 'image']
] as const

const placements: {
  id: Placement
  title: string
  note: string
  size?: number
}[] = [
  {
    id: 'beside',
    title: '1 · Beside the h1',
    note: 'Bare mark left of the title, optically centred. Strongest identity; eats title width.',
    size: 72
  },
  {
    id: 'above',
    title: '2 · Above the h1',
    note: 'App-icon hero. Works on mobile; pushes the title down.',
    size: 80
  },
  {
    id: 'inline',
    title: '3 · Inline before the title',
    note: 'Favicon-like. Constrained to text size, so it reads as a glyph.'
  },
  {
    id: 'kicker',
    title: '4 · Kicker above the h1',
    note: 'Tiny mark with the category. Subtle, but duplicates the category.'
  },
  {
    id: 'suffix',
    title: '5 · After the “cheatsheet” suffix',
    note: 'Low-prominence brand mark. Easy to miss.'
  },
  {
    id: 'watermark',
    title: '6 · Watermark behind the h1',
    note: 'Oversized ghost mark. Only works for simple silhouettes.'
  }
]
---

<BaseLayout title="Sheet logo placements">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <div class="wrap">
    <header class="intro">
      <p class="eyebrow">Specimen · throwaway exploration</p>
      <h1>Sheet logo placements</h1>
      <p>
        Same sheet (<code>react</code>), six places on the sheet page. Two logo
        treatments: <strong>bare</strong> (no background or border, mark is the
        slot) and <strong>app icon</strong> (brand-tinted background, bigger
        mark, no border, soft shadow). Top nav and intro card omitted.
      </p>
    </header>

    <section class="types">
      <h2>1 · Bare marks, 64px</h2>
      <p class="note">
        No background, no border. Image marks get a small radius.
      </p>
      <div class="tiles">
        {marks.map(([slug, kind]) => (
          <figure>
            <Logo slug={slug} size={64} />
            <figcaption>
              {slug} · {kind}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="types">
      <h2>2 · App-icon variant, 64px</h2>
      <p class="note">
        Brand-tinted background, icon at 90%, no border, soft shadow.
      </p>
      <div class="tiles">
        {marks.map(([slug, kind]) => (
          <figure>
            <Logo slug={slug} size={64} variant="app" />
            <figcaption>
              {slug} · {kind}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="types">
      <h2>3 · Bare size ladder</h2>
      <p class="note">The mark always fills the slot; no chip.</p>
      <div class="tiles sizes">
        {[40, 48, 56, 64, 80].map((size) => (
          <figure>
            <Logo slug="react" size={size} />
            <figcaption>{size}px</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {placements.map((placement) => (
      <section class="specimen">
        <div class="specimen-meta">
          <h2>{placement.title}</h2>
          <p>{placement.note}</p>
        </div>
        <div class="specimen-frame">
          <SheetLogoSpecimen
            page={react}
            placement={placement.id}
            size={placement.size ?? 56}
          />
        </div>
      </section>
    ))}

    <section class="specimen">
      <div class="specimen-meta">
        <h2>7 · Beside the h1, across logo types</h2>
        <p>
          Same placement with a colour mark, a mono square, an image mark, and a
          glyph.
        </p>
      </div>
      <div class="specimen-frame stack">
        <SheetLogoSpecimen page={react} placement="beside" size={72} />
        <SheetLogoSpecimen page={claude} placement="beside" size={72} />
        <SheetLogoSpecimen page={go} placement="beside" size={72} />
        <SheetLogoSpecimen page={herdr} placement="beside" size={72} />
        <SheetLogoSpecimen page={xpath} placement="beside" size={72} />
      </div>
    </section>

    <section class="specimen">
      <div class="specimen-meta">
        <h2>8 · Beside the h1, app-icon variant</h2>
        <p>64px tinted tiles, no border, soft shadow.</p>
      </div>
      <div class="specimen-frame stack">
        <SheetLogoSpecimen
          page={react}
          placement="beside"
          size={64}
          variant="app"
        />
        <SheetLogoSpecimen
          page={claude}
          placement="beside"
          size={64}
          variant="app"
        />
        <SheetLogoSpecimen
          page={go}
          placement="beside"
          size={64}
          variant="app"
        />
        <SheetLogoSpecimen
          page={herdr}
          placement="beside"
          size={64}
          variant="app"
        />
      </div>
    </section>

    <section class="specimen">
      <div class="specimen-meta">
        <h2>9 · Beside the h1, 56 vs 64 vs 72</h2>
        <p>Bare marks at three header sizes.</p>
      </div>
      <div class="specimen-frame stack">
        <SheetLogoSpecimen page={react} placement="beside" size={56} />
        <SheetLogoSpecimen page={react} placement="beside" size={64} />
        <SheetLogoSpecimen page={react} placement="beside" size={72} />
      </div>
    </section>

    <footer class="foot">
      <p>
        Throwaway specimen page. Sources: <code>logos</code>,
        <code>simple-icons</code>, <code>icon-park-outline</code>; official SVGs
        for Herdr and mise.
      </p>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/markdown/a-em.css';
  @import '../../styles/markdown/code.css';
  @import '../../styles/markdown/headings.css';
  @import '../../styles/markdown/p.css';
  @import '../../styles/markdown/table.css';
  @import '../../styles/markdown/ul.css';
  @import '../../styles/components/h2-section.css';
  @import '../../styles/components/h3-section.css';
  @import '../../styles/components/h3-section-list.css';
  @import '../../styles/components/main-heading.css';
</style>

<style>
  .wrap {
    max-width: 920px;
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .intro {
    margin-bottom: 48px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--base-mute4);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro h1 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 40px;
    line-height: 1.15;
    color: var(--base-head);
  }

  .intro p {
    max-width: 680px;
    color: var(--base-text);
  }

  .types,
  .specimen {
    margin: 0 0 56px;
  }

  .types h2,
  .specimen-meta h2 {
    margin: 0 0 6px;
    font-family: var(--font-heading);
    font-size: 18px;
    color: var(--base-head);
  }

  .note,
  .specimen-meta p {
    max-width: 640px;
    margin: 0 0 16px;
    color: var(--base-mute);
    font-size: 14px;
  }

  .tiles {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 28px;
    margin-top: 20px;
  }

  .tiles figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .tiles figcaption {
    color: var(--base-mute4);
    font-size: 11px;
    white-space: nowrap;
  }

  .sizes {
    align-items: center;
  }

  .specimen-frame {
    padding: 32px;
    border: 1px solid var(--line-color);
    border-radius: 12px;
    background: var(--base-body);
  }

  .specimen-frame.stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .foot {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line-color);
    color: var(--base-mute4);
    font-size: 13px;
  }
</style>
